# The server reads server/.env. Copy the lines you need there and fill them in. Never commit .env.
# Empty values are ignored; a variable already set in the shell wins over the file.
APP_ENV=dev
# DATABASE_URL defaults to server/data/aura.db when empty
DATABASE_URL=
JWT_SECRET=change-me
# STT_PROVIDER: auto (default: sarvam when SARVAM_API_KEY is set, else vosk) | sarvam | vosk (offline) | mock
STT_PROVIDER=auto
SARVAM_API_KEY=
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# LLM_PROVIDER: mock (= rule-based extractor, offline) | anthropic (LLM proposal -> same code validator;
# falls back to rule-based if the API fails). Key: LLM_API_KEY, or ANTHROPIC_API_KEY.
LLM_PROVIDER=mock
LLM_API_KEY=
# claude-haiku-5-5 | claude-sonnet-5-5 | claude-opus-5-5 — pick by the eval bake-off (T-026)
LLM_MODEL=claude-haiku-5-5
# LLM_EFFORT: low | medium | high
LLM_EFFORT=low
AUDIO_RETENTION_HOURS=168
