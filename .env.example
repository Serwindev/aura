# The server reads server/.env. Copy the lines you need there and fill them in. Never commit .env.
# Empty values are ignored; a variable already set in the shell wins over the file.
APP_ENV=dev
# DATABASE_URL defaults to server/data/aura.db when empty
DATABASE_URL=
JWT_SECRET=change-me
# STT_PROVIDER: auto (default: sarvam when SARVAM_API_KEY is set, else vosk) | sarvam | vosk (offline) | mock
STT_PROVIDER=auto
SARVAM_API_KEY=
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# LLM_PROVIDER (free options only; LLM proposal -> same code validator; rule-based if it fails):
#   mock          rule-based extractor, offline (default)
#   ollama        local model, free and private: install Ollama, `ollama pull qwen2.5:3b`
#   groq | gemini free cloud tiers: set LLM_API_KEY and LLM_MODEL (check the vendor's current
#                 free models and data terms; free tiers may keep what is sent — synthetic data only)
#   openai_compat any OpenAI-compatible server: set LLM_BASE_URL (+ LLM_MODEL, LLM_API_KEY)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
AUDIO_RETENTION_HOURS=168
